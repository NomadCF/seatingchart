{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomadcf.github.io/seatingchart/schemas/planner-command-v1.schema.json",
  "title": "Classroom Seating Planner command preview v1",
  "type": "object",
  "required": ["schema", "version", "command", "intent", "title", "summary", "mutates", "entities", "parameters", "operations", "blockers", "ambiguities"],
  "properties": {
    "schema": { "const": "classroom-seating-planner-command-v1" },
    "version": { "const": 1 },
    "command": { "type": "string", "maxLength": 2000 },
    "intent": {
      "type": "string",
      "enum": [
        "unknown",
        "ambiguous",
        "show_valid_seats",
        "explain_selected_seat",
        "explain_student",
        "explain_conflicts",
        "rule_changes",
        "group_rule_change",
        "testing_preview",
        "open_station_rotations",
        "switch_activity_layout",
        "preview_repair"
      ]
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "mutates": { "type": "boolean" },
    "entities": {
      "type": "object",
      "properties": {
        "students": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "parameters": { "type": "object" },
    "operations": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message", "candidates"],
        "properties": {
          "message": { "type": "string" },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
